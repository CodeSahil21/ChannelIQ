# API Configuration
VITE_API_BASE_URL=https://api.corporate.local
VITE_SOCKET_BASE_URL=https://api.corporate.local

# Development Override (uncomment for local development)
# VITE_API_BASE_URL=http://localhost:4000
# VITE_SOCKET_BASE_URL=http://localhost:3004

# Feature Flags
VITE_ENABLE_CHAT=true
VITE_ENABLE_CONNECTIONS=true
VITE_ENABLE_GROUPS=true
VITE_ENABLE_MEETINGS=true

# Environment
VITE_NODE_ENV=production

# Media Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Security
VITE_ENABLE_ANALYTICS=false