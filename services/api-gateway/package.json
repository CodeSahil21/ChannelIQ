{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "API Gateway for Corporate Chat microservices",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec \"tsc && node dist/server.js\" --watch src --ext ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "cors": "^2.8.5",
