{
  "restartable": "rs",
  "ignore": [
    ".git",
    "node_modules/**/node_modules",
    "dist"
  ],
  "verbose": true,
  "execMap": {
    "js": "node",
    "ts": "ts-node"
  },
  "events": {
    "restart": "echo 'Restarting all services...'"
  },
  "env": {
    "NODE_ENV": "development"
  },
  "ext": "js,json,ts"
}