generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}
datasource db {
  provider = "postgresql"
}
model User {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  password         String
  otp              String?
  otpExpiresAt     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
